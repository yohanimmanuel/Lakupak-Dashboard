{
  "name": "laku",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:env": "tsx src/scripts/validateEnv.ts",
    "ci:check": "npm run validate:env && prisma generate && prisma validate && npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "ws": "tsx src/server/websocket.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run ws\"",
    "meili:reindex:marketplace": "npx --yes tsx src/scripts/meiliReindexMarketplaceProducts.ts",
    "marketplace:search:report": "tsx src/scripts/marketplaceSearchReport.ts",
    "analytics:demo:seed": "tsx src/scripts/analyticsDemoOrders.ts seed",
    "analytics:demo:cleanup": "tsx src/scripts/analyticsDemoOrders.ts cleanup",
    "docs:index": "tsx src/scripts/meiliIndexDocs.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/next": "^4.1.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^7.3.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "driver.js": "^1.4.0",
    "graphql": "^16.12.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.4.1",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.539.0",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.16.0",
    "meilisearch": "^0.57.0",
    "next": "16.2.12",
    "next-auth": "^4.24.11",
    "next-cloudinary": "^6.16.0",
    "next-intl": "^4.13.4",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^19.2.4",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.1.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "swr": "^2.3.6",
    "twilio": "^5.9.0",
    "unified": "^11.0.5",
    "winston": "^3.19.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5",
    "zustand": "^5.0.7"
  },
  "overrides": {
    "lodash": "4.17.23",
    "tar": "7.5.7",
    "glob": "10.5.0",
    "axios": "1.13.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-map-gl": "^6.1.7",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
