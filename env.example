# =============================================================================
# Laku Dashboard — environment variables
# Copy to `.env` (and optionally `.env.local`). Run `npm run validate:env` to check.
#
# REQUIRED (runtime):
#   DATABASE_URL, AUTH_SECRET, JWT_SECRET
# REQUIRED (production + migrations):
#   REDIS_URL, DIRECT_URL
# OPTIONAL (feature integrations — app starts without them):
#   MEILI_*, CLOUDINARY_*, TWILIO_*, SMTP_*, AUDIT_*, MAPBOX_*
# =============================================================================

# Database Configuration (Supabase)
# 
# DATABASE_URL: PRIMARY connection used by your app runtime (db.ts, route.ts)
# - Use Session Pooler URL (port 5432 with ?pgbouncer=true) for regular app queries
# - This is used by PrismaClient adapter for ALL database operations in your app
# - Your app ALWAYS uses this URL first for queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"

# DIRECT_URL: ONLY used by Prisma Migrate commands (migrate deploy/dev/resolve)
# - Use Direct Connection URL (port 5432 without pooler) for migrations only
# - NOT used by your app runtime - only by migration commands
# - Prisma Migrate automatically uses this when running migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# PRISMA_DISABLE_PREPARED_STATEMENTS: Set to true if you encounter "prepared statement already exists" errors
# - With Prisma 7 + @prisma/adapter-pg + Session Pooler, prepared statements should work
# - However, if you still get errors, set this to true
# - Default: false (prepared statements enabled for better performance)
PRISMA_DISABLE_PREPARED_STATEMENTS=false

# Database Connection Pool Configuration
DB_POOL_MAX=20              # Maximum connections in pool
DB_POOL_MIN=2               # Minimum connections in pool
DB_CONNECTION_TIMEOUT_MS=10000    # Connection timeout (10 seconds)
DB_IDLE_TIMEOUT_MS=30000          # Idle connection timeout (30 seconds)
DB_QUERY_TIMEOUT_MS=30000         # Query execution timeout (30 seconds)

# Database Query Rate Limiting
DB_QUERY_RATE_LIMIT=1000    # Maximum queries per minute per user/IP

# Google Analytics (Production)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Mapbox (Live Delivery Tracking). Token is served at runtime via /api/mapbox-token (no URLs/tokens in Dockerfile).
# Set MAPBOX_ACCESS_TOKEN or NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN in .env / env_file for Docker.
MAPBOX_ACCESS_TOKEN="pk.your-mapbox-public-token"

# Security Configuration (NextAuth uses AUTH_SECRET)
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# API Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Redis Configuration (for caching)
REDIS_URL="redis://localhost:6379"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-long-random-secret"

# Meilisearch (marketplace product search — optional; falls back to Postgres when unset)
# MEILI_HOST="http://localhost:7700"
# MEILI_MASTER_KEY="your-master-key"
# MARKETPLACE_SEARCH_ENGINE="auto"

# WebSocket (real-time notifications for Dashboard; server runs via WS_PORT, e.g. 3001)
# NEXT_PUBLIC_WS_PORT: used by the Dashboard to build ws://host:PORT (default 3001)
# NEXT_PUBLIC_WS_URL: optional override, e.g. "wss://your-domain.com" when proxying WS to the same host
# NEXT_PUBLIC_WS_PORT="3001"
# NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Twilio (for OTP SMS/WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM="+1234567890"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_VERIFY_SID=""

# Cloudinary (for image storage). All server-only; nothing is sent to the client.
# Use CLOUDINARY_CLOUD_NAME (or NEXT_PUBLIC_* for backward compat; prefer non-public).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Audit Logging Service (Axiom)
# Get your API token from: https://app.axiom.co/settings/api-tokens
# Create a dataset first, then use: https://api.axiom.co/v1/datasets/{DATASET_NAME}/ingest
AUDIT_SERVICE_URL="https://api.axiom.co/v1/datasets/audit-logs/ingest"
AUDIT_SERVICE_TOKEN="your-axiom-api-token-here"
