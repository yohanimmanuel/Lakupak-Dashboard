generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int        @id @default(autoincrement())
  firstName     String?
  lastName      String?
  email         String     @unique
  password      String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  currency      String     @default("IDR")
  region        String?
  emailVerified DateTime?
  image         String?
  name          String?
  avatar        String?
  bio           String?
  location      String?
  phone         String?
  companyId     Int?
  language      String     @default("en")
  accounts      Account[]
  buyers        Buyer[]
  orders        Order[]
  products      Product[]
  sessions      Session[]
  suppliers     Supplier[]
  offers        Offer[]
  company       Company?   @relation(fields: [companyId], references: [id])
  salesAgents   SalesAgent[]
  salesTeams    SalesTeam[]
  campaigns     Campaign[]
}

model Company {
  id                          Int      @id @default(autoincrement())
  name                        String
  businessRegistrationNumber  String?
  taxId                       String?
  logo                        String?
  industryType                String?
  businessDescription         String?
  yearsInOperation            String?
  companySize                 String?
  businessAddress             String?
  businessPhone               String?
  businessEmail               String?
  documentVerification        Boolean  @default(false)
  businessLicenseVerification Boolean  @default(false)
  complianceStatus            String   @default("Pending")
  shippingPreferences         String?
  deliveryTimeSlots           String?
  preferredDeliveryDays       String?
  specialInstructions         String?
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)
  bannerImage                 String?
  additionalPricePerKm        Decimal? @db.Decimal(12, 2)
  baseShippingPrice           Decimal? @db.Decimal(12, 2)
  baseShippingRadius          Decimal? @db.Decimal(12, 2)
  freeShippingThreshold       Decimal? @db.Decimal(12, 2)
  maxShippingRadius           Decimal? @db.Decimal(12, 2)
  expressShippingPrice        Decimal? @db.Decimal(12, 2)
  nextDayShippingPrice        Decimal? @db.Decimal(12, 2)
  sameDayShippingPrice        Decimal? @db.Decimal(12, 2)
  pickupAddress               String?
  users                       User[]
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Product {
  id                Int              @id @default(autoincrement())
  productId         String           @unique
  sku               String
  name              String
  description       String
  productType       String
  brand             String
  supplier          String
  status            String
  productCategory   String
  catalogName       String
  images            String[]
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  userId            Int?
  bpomApproved      Boolean?         @default(false)
  halalCertified    Boolean?         @default(false)
  originalProduct   Boolean?         @default(true)
  returnPolicyDays  Int?             @default(7)
  lastSyncAt        DateTime?
  marketplaceStatus String?          @default("Not Published")
  publishedAt       DateTime?
  // Product-level stock is computed from sum of all variant stocks
  // Use getProductTotalStock() helper function to calculate
  variants          ProductVariant[]
  orderItems        OrderItem[]
  offerProducts     OfferProduct[]
  // New variant modeling (definitions and options for combinations)
  variantOptions    VariantOption[]
  favoriteProducts  FavoriteProduct[]
  user              User?            @relation(fields: [userId], references: [id])
}

model ProductVariant {
  id          Int         @id @default(autoincrement())
  productId   Int
  variantType String // e.g. "Color", "Size"
  options     Json // e.g. ["Red","Blue"] for this type
  position    Int // order 1..n in UI
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@unique([productId, variantType])
  @@index([productId, position])
}

model MarketplaceUser {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String?        @unique
  password       String?
  bio            String?
  phone          String         @unique
  country        String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  name           String?
  storeName      String?
  chosenAddress  String?
  image          String?
  bannerImage    String?
  addresses      Address[]
  userActivities UserActivity[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

model Address {
  id        Int             @id @default(autoincrement())
  userId    Int
  fullName  String
  phone     String
  address   String
  isDefault Boolean         @default(false)
  label     String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  user      MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([userId, isDefault])
}

model Order {
  id                      Int         @id @default(autoincrement())
  orderId                 String      @unique
  buyerId                 String?
  orderDate               DateTime    @db.Timestamptz(3)
  orderStatus             String
  paymentStatus           String
  deliveryMethod          String
  deliveryOption          String?
  subtotal                Decimal @db.Decimal(12, 2)
  discounts               Decimal @db.Decimal(12, 2)
  shippingFee             Decimal @db.Decimal(12, 2)
  totalAmount             Decimal @db.Decimal(12, 2)
  paymentTerms            String
  totalOrders             Int
  contactPerson           String
  storeName               String
  contactPhone            String
  customerEmail           String?
  deliveryAddress         String
  preferredDeliveryDate   DateTime?   @db.Timestamptz(3)
  preferredDeliveryTime   String?
  preferredPickupDate     DateTime?   @db.Timestamptz(3)
  preferredPickupTime     String?
  assignedLogistics       String?
  trackingNumber          String?
  deliveryNote            String?
  deliveryConfirmation    String?
  pod                     String?
  shippingMethodLabel     String?
  shippingMethod          String?
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(3)
  acceptedBy              String?
  acceptedAt              DateTime?   @db.Timestamptz(3)
  userId                  Int?
  archivedAt              DateTime?   @db.Timestamptz(3)
  cancelledAt             DateTime?   @db.Timestamptz(3)
  cancelledBy             String?
  cancellationReason      String?
  isDeleted               Boolean     @default(false)
  buyerIdSnapshot         String?
  contactPersonSnapshot   String?
  contactPhoneSnapshot    String?
  customerEmailSnapshot   String?
  deliveryAddressSnapshot String?
  orderDateSnapshot       DateTime?   @db.Timestamptz(3)
  storeNameSnapshot       String?
  buyer                   Buyer?      @relation(fields: [buyerId], references: [buyerId])
  user                    User?       @relation(fields: [userId], references: [id])
  orderItemsRel           OrderItem[]
}

model OrderItem {
  id                       Int             @id @default(autoincrement())
  orderId                  String
  productId                String?
  variantId                Int? // Reference to ProductVariant
  variantOptionId          Int? // Reference to VariantOption (new combinations table)
  subtotal                 Decimal @db.Decimal(12, 2)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)
  productNameSnapshot      String?
  productSkuSnapshot       String?
  productTypeSnapshot      String?
  variantNameSnapshot      String? // Variant name at time of order
  test                     String?
  packageQuantity          Int?            @default(1)
  packageType              String?
  piecesPerPackage         Int?            @default(1)
  pricePerPackage          Decimal? @db.Decimal(12, 2)
  // Offer snapshots - preserve offer status at time of purchase
  offerApplied             Boolean?        @default(false)
  offerBadgeSnapshot       String? // 'Discount', 'Promotion', 'All Offers', 'Offer'
  offerNameSnapshot        String? // Name of the offer at time of purchase
  originalPriceSnapshot    Decimal? @db.Decimal(12, 2) // Original price before discount (for display)
  discountPercentage       Decimal? @db.Decimal(5, 2) // Calculated discount % at time of purchase (for percentage discounts)
  discountAmount           Decimal? @db.Decimal(12, 2) // Fixed discount amount at time of purchase (for fixed discounts)
  promotionDetailsSnapshot String? // JSON string of promotion details {minQuantity, freeQuantity, description}
  moqSnapshot              Int? // MOQ at time of order (in pieces) - for accurate promotion calculation in order history
  order                    Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product                  Product?        @relation(fields: [productId], references: [productId])
  variant                  ProductVariant? @relation(fields: [variantId], references: [id])
  variantOption            VariantOption?  @relation(fields: [variantOptionId], references: [id])
}

/// Combination rows for a product (each row corresponds to a concrete variant combination)
model VariantOption {
  id                   Int      @id @default(autoincrement())
  productId            Int
  variantName          String // e.g., "Color: Red | Size: M"
  attributes           Json // {"Color":"Red","Size":"M"}
  sku                  String?
  purchasePrice        Decimal @db.Decimal(12, 2)
  sellingPrice         Decimal @db.Decimal(12, 2)
  originalSellingPrice Decimal? @db.Decimal(12, 2)
  moq                  Int?
  stockQuantity        Int      @default(0)
  lowStockThreshold    Int      @default(0)
  stockStatus          String   @default("In Stock")
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, variantName])
  @@index([productId, isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// OTP codes for mobile authentication
model OtpCode {
  id          Int       @id @default(autoincrement())
  phone       String
  countryCode String?
  channel     String
  code        String
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  ipAddress   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

/// Generic user activity tracking for marketplace users
model UserActivity {
  id           Int             @id @default(autoincrement())
  userId       Int
  productId    String // Reference to marketplace product ID
  productData  Json // Store complete product data as JSON
  activityType String // 'cart', 'favorite', 'viewed', 'purchased'
  metadata     Json? // Additional data (quantity, variant, etc.)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  user         MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityType])
  @@index([productId])
  @@index([activityType])
}

model Offer {
  id                 String   @id @default(cuid())
  offerId            String   @unique
  name               String
  description        String?
  type               String[] // ['discount', 'promotion'] - can contain multiple types
  status             String // 'active' | 'scheduled' | 'inactive' (inactive = manually deactivated OR expired)
  totalUsage         Int      @default(0)
  totalDiscountGiven Decimal  @default(0) @db.Decimal(12, 2)
  userId             Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  user               User?               @relation(fields: [userId], references: [id])
  offerProducts      OfferProduct[]
  offerDiscountTypes OfferDiscountType[]
  dateRanges         DateRange[]

  @@index([userId])
  @@index([status])
  @@index([type])
}

model OfferDiscountType {
  id            String   @id @default(cuid())
  offerId       String
  discountType  String // 'percentage' | 'fixed' | 'buy_x_get_y'
  discountValue Decimal  @db.Decimal(10, 2)
  name          String? // e.g., "Summer Sale Discount"
  description   String? // e.g., "4% discount on all items"
  minOrderValue Decimal? @db.Decimal(12, 2) // minimum order value for this discount type
  minQuantity   Int? // minimum quantity required
  // per-customer usage limit removed
  isActive      Boolean  @default(true)
  priority      Int      @default(1) // Higher number = higher priority
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([discountType])
  @@index([priority])
}

model OfferProduct {
  id        String @id @default(cuid())
  offerId   String
  productId String

  // Relations
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([offerId, productId])
  @@index([offerId])
  @@index([productId])
}

model DateRange {
  id          String    @id @default(cuid())
  offerId     String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([startDate, endDate])
  @@index([deletedAt])
}

model OfferUsageTracking {
  id                String   @id @default(cuid())
  offerId           String
  discountTypeId    String? // Track per discount type, null for overall offer usage
  marketplaceUserId Int? // For marketplace users
  usageCount        Int      @default(1)
  lastUsedAt        DateTime @default(now()) @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@unique([offerId, discountTypeId, marketplaceUserId])
  @@index([offerId])
  @@index([discountTypeId])
  @@index([marketplaceUserId])
}

// Sales Module Models
model SalesAgent {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String
  role          String          // 'Sales Manager', 'Sales Rep', 'Sales Support', 'Lead Gen', 'Account Manager'
  status        String          // 'active', 'inactive'
  avatar        String?
  territory     String?
  bio           String?         // About me / biography
  sex           String?         // Gender (e.g., 'Male', 'Female', 'Other')
  teamId       String?
  userId       Int?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  team          SalesTeam?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fieldReports  FieldReport[]
  salesTargets  SalesTarget[]
  favoriteProducts FavoriteProduct[]

  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model SalesTeam {
  id            String          @id @default(uuid())
  name          String          // Region name (e.g., "Jakarta Team", "Regional Team")
  userId       Int?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  members       SalesAgent[]

  @@index([userId])
}

model FieldReport {
  id            String          @id @default(uuid())
  salesAgentId  String
  date          DateTime        @db.Timestamptz(3)
  location      String?
  startTime     String?         // e.g., "08:00"
  endTime       String?          // e.g., "17:00"
  activities    Json?            // { visits, customersMet, productsDemonstrated, salesMade }
  notes         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  salesAgent    SalesAgent      @relation(fields: [salesAgentId], references: [id], onDelete: Cascade)

  @@index([salesAgentId])
  @@index([date])
}

model SalesTarget {
  id            String          @id @default(uuid())
  salesAgentId  String
  period        String          // e.g., "October", "Q4 2024"
  goal          Decimal         @db.Decimal(12, 2)
  achieved     Decimal         @default(0) @db.Decimal(12, 2)
  unitsSold     Int              @default(0)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  salesAgent    SalesAgent      @relation(fields: [salesAgentId], references: [id], onDelete: Cascade)

  @@index([salesAgentId])
  @@index([period])
}

model FavoriteProduct {
  id            String          @id @default(uuid())
  salesAgentId  String
  productId     Int
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  salesAgent    SalesAgent      @relation(fields: [salesAgentId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([salesAgentId, productId])
  @@index([salesAgentId])
  @@index([productId])
}

model Campaign {
  id            String   @id @default(cuid())
  campaignId   String   @unique
  name          String
  description   String?
  status        String   @default("Draft") // 'Draft' | 'Scheduled' | 'Sent' | 'Completed'
  sentDate      DateTime? @db.Timestamptz(3)
  recipients    String
  opensCount    Int      @default(0)
  clicksCount   Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(12, 2)
  orders        Int      @default(0)
  contentBlocks Json?    // Store CampaignContentBlock[] as JSON
  userId        Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([campaignId])
  @@index([createdAt])
}
