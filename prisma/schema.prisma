generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String
  lastName  String
  email     String     @unique
  password  String
  company   String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buyers    Buyer[]
  suppliers Supplier[]
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}
