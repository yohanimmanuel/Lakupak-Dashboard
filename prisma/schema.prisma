generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  compilerBuild   = "fast"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int        @id @default(autoincrement())
  firstName     String?
  lastName      String?
  email         String     @unique
  password      String?
  isSuspended   Boolean    @default(false)
  suspendedAt   DateTime?
  suspensionReason String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  currency      String     @default("IDR")
  region        String?
  emailVerified DateTime?
  image         String?
  name          String?
  avatar        String?
  bio           String?
  phone         String?
  /// Distributor company this dashboard user belongs to.
  companyId     Int?
  language      String     @default("en")
  /// Dashboard product-tour progress (merged with localStorage); optional cross-device sync.
  dashboardTourState Json?
  /// Monotonic counter for round-robin sales-agent assignment (per distributor user).
  salesAgentRoundRobinCursor Int @default(0)
  /// Dashboard account lifecycle: "active" | "pending". New registrations start pending until KYC is approved.
  accountStatus String     @default("active")
  accounts      Account[]
  buyers        Buyer[]
  orders        Order[]
  products      Product[]
  sessions      Session[]
  suppliers     Supplier[]
  offers        Offer[]
  company       Company?   @relation("CompanyToUsers", fields: [companyId], references: [id], onDelete: SetNull)
  salesAgents   SalesAgent[]
  salesTeams    SalesTeam[]
  notifications Notification[]
  distributorReviewsReceived DistributorReview[]
  reportedDistributorReports DistributorReport[] @relation("ReportedDistributorReports")
  distributorFollowers       DistributorFollowing[]
  fleets        Fleet[]
  drivers       Driver[]
  automationWorkflows AutomationWorkflow[]
  passwordResetTokens PasswordResetToken[]
  kycResubmitTokens KycResubmitToken[]
  salesJobs SalesJob[]
  salesJobSettings SalesJobSettings?
  clientMatchCandidates ClientMatchCandidate[]

  @@index([companyId])
  @@index([accountStatus])
}

model Company {
  id                          Int      @id @default(autoincrement())
  name                        String
  businessRegistrationNumber  String?
  taxId                       String?
  logo                        String?
  industryType                String?
  businessDescription         String?
  yearsInOperation            String?
  /// Manual delivery coverage area entered by the distributor (not computed).
  deliveryCoverageArea        String?
  /// Manual fulfillment / trust notes for marketplace profiles (placeholder until real stats exist).
  fulfillmentNotes            String?
  companySize                 String?
  businessAddress             String?
  businessPhone               String?
  businessEmail               String?
  /// Bank account used for buyer manual transfers and future billing/commission charges.
  billingBankName             String?
  billingBankAccountName      String?
  billingBankAccountNumber    String?
  /// Billing / invoice address (may differ from business or pickup address).
  billingCompanyName     String?
  billingAddressLine1    String?
  billingCity            String?
  billingState           String?
  billingPostalCode      String?
  billingCountry         String?
  billingContactPhone    String?
  billingContactEmail    String?
  documentVerification        Boolean  @default(false)
  businessLicenseVerification Boolean  @default(false)
  complianceStatus            String   @default("Pending")
  /// NIB (Nomor Induk Berusaha) scan uploaded at registration.
  nibDocumentUrl              String?
  nibDocumentName             String?
  nibDocumentPublicId         String?
  /// NPWP (tax ID) scan uploaded at registration.
  npwpDocumentUrl             String?
  npwpDocumentName            String?
  npwpDocumentPublicId        String?
  shippingPreferences         String?
  deliveryTimeSlots           String?
  preferredDeliveryDays       String?
  specialInstructions         String?
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)
  bannerImage                 String?
  pickupAddress               String?
  defaultDeliveryLeadTimeMinDays Int?
  defaultDeliveryLeadTimeMaxDays Int?
  /// Days after purchase by which buyers must complete bank transfer (shown on Pay Order).
  buyerPaymentTermDays         Int?
  /// When ON, first-time marketplace buyers without a client rate get the catalog/base price on PO submit.
  autoApplyBasePriceForFirstBuyers Boolean @default(false)
  /// Dashboard users linked via User.companyId (FK on User).
  users                       User[]                 @relation("CompanyToUsers")
  paymentMethods              CompanyPaymentMethod[]
  commissionInvoices          CommissionInvoice[]
}

enum CompanyPaymentMethodKind {
  CARD
  BANK_TRANSFER
  EWALLET
}

enum CompanyPaymentMethodStatus {
  ACTIVE
  EXPIRED
  PENDING
}

/// Saved payment methods for a distributor company (cards, bank debit accounts, e-wallets).
/// Clients submit type + details only; full PANs / account numbers are never stored.
model CompanyPaymentMethod {
  id                 String                     @id @default(cuid())
  companyId          Int
  kind               CompanyPaymentMethodKind
  /// System-generated from kind + details (e.g. "Card ····4242"). Not a user-facing display label input.
  label              String
  /// Card last 4 digits only (derived from cardNumber on create/update).
  last4              String?
  expiryMonth        Int?
  expiryYear         Int?
  bankName           String?
  accountHolderName  String?
  /// Bank account last 4 digits only (derived from accountNumber on create/update).
  accountNumberLast4 String?
  ewalletProvider    String?
  isDefault          Boolean                    @default(false)
  status             CompanyPaymentMethodStatus @default(ACTIVE)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isDefault])
}

enum CommissionInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

/// Commission fee invoice submitted by a platform admin to a distributor company.
/// The invoice document (PDF/DOCX) is generated outside Laku and uploaded here for record-keeping.
model CommissionInvoice {
  id                   String                 @id @default(cuid())
  /// Human-readable invoice number (e.g. COM-2026-05-0001).
  invoiceNo            String                 @unique
  companyId            Int
  /// Month being billed (normalized to first day of month, UTC).
  billingMonth         DateTime               @db.Timestamptz(3)
  amount               Decimal                @db.Decimal(18, 2)
  currency             String                 @default("IDR")
  status               CommissionInvoiceStatus @default(PENDING)
  issuedAt             DateTime               @default(now()) @db.Timestamptz(3)
  dueAt                DateTime?              @db.Timestamptz(3)
  description          String?
  documentUrl          String
  documentPublicId     String?
  createdByAdminId     Int?
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByAdmin   PlatformAdmin? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([companyId, billingMonth])
  @@index([companyId, status])
  @@index([issuedAt])
  @@index([dueAt])
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]
  offers       Offer[]
  salesJobs    SalesJob[]
  matchCandidates ClientMatchCandidate[] @relation("MatchExistingClient")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Product {
  id                Int              @id @default(autoincrement())
  productId         String           @unique
  sku               String
  name              String
  description       String
  productType       String
  brand             String
  supplier          String
  status            String
  /// Sales channel: Retail / Wholesale / Both (not merchandising taxonomy)
  productCategory   String
  /// Stable slug from MERCHANDISING_CATEGORIES (e.g. mobile-accessories)
  merchandisingCategorySlug String?
  catalogName       String
  images            String[]
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  userId            Int?
  bpomApproved      Boolean?         @default(false)
  halalCertified    Boolean?         @default(false)
  originalProduct   Boolean?         @default(true)
  returnPolicyDays  Int?             @default(7)
  lastSyncAt        DateTime?
  marketplaceStatus String?          @default("Not Published")
  publishedAt       DateTime?
  // Product-level stock is computed from sum of all variant stocks
  // Use getProductTotalStock() helper function to calculate
  variants          ProductVariant[]
  orderItems        OrderItem[]
  offers            Offer[]
  // New variant modeling (definitions and options for combinations)
  variantOptions    VariantOption[]
  favoriteProducts  FavoriteProduct[]
  user              User?            @relation(fields: [userId], references: [id])
  productReviews    ProductReview[]

  // Indexes for performance - added to fix slow queries
  @@index([userId])
  @@index([status])
  @@index([marketplaceStatus])
  @@index([productCategory])
  @@index([merchandisingCategorySlug])
  @@index([userId, marketplaceStatus])
  @@index([createdAt])
}

model ProductVariant {
  id          Int         @id @default(autoincrement())
  productId   Int
  variantType String // e.g. "Color", "Size"
  options     Json // e.g. ["Red","Blue"] for this type
  position    Int // order 1..n in UI
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@unique([productId, variantType])
  @@index([productId, position])
}

model MarketplaceUser {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String?        @unique
  password       String?
  bio            String?
  phone          String?        @unique
  country        String?
  isSuspended    Boolean        @default(false)
  suspendedAt    DateTime?
  suspensionReason String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  name           String?
  storeName      String?
  chosenAddress  String?
  image          String?
  bannerImage    String?
  addresses              Address[]
  userActivities         UserActivity[]
  searchHistory          SearchHistory[]
  pushNotificationTokens PushNotificationToken[]
  productReviews         ProductReview[]
  orderDeliveryReviews   OrderDeliveryReview[]
  distributorReviews     DistributorReview[]
  orderReturnRequests    OrderReturnRequest[]
  orderCancellations     OrderCancellation[]
  passwordResetTokens    MarketplacePasswordResetToken[]
  distributorReportsSubmitted DistributorReport[]
  distributorFollowings       DistributorFollowing[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

/// Marketplace buyer follows a dashboard distributor (seller).
model DistributorFollowing {
  id                Int             @id @default(autoincrement())
  marketplaceUserId Int
  distributorId     Int
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  marketplaceUser MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)
  distributor     User            @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([marketplaceUserId, distributorId])
  @@index([marketplaceUserId])
  @@index([distributorId])
  @@index([createdAt])
}

/// Password reset token for marketplace users (hashed token + expiry).
model MarketplacePasswordResetToken {
  id                Int             @id @default(autoincrement())
  marketplaceUserId Int
  tokenHash         String          // SHA-256 hash of the raw token sent in email
  expiresAt         DateTime        @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  marketplaceUser   MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)

  @@index([marketplaceUserId])
  @@index([expiresAt])
}

/// Token emailed after KYC rejection so the distributor can replace NIB/NPWP without signing in.
model KycResubmitToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

/// Short-lived, single-use proof issued after Google OAuth so a pending stub can be resumed.
model GoogleRegisterProof {
  id         Int       @id @default(autoincrement())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email])
  @@index([expiresAt])
}

/// Password reset token for dashboard (distributor) users (hashed code + expiry).
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   // SHA-256 hash of the raw code sent by email
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Cancellation record from marketplace buyer (structured reason + detail).
model OrderCancellation {
  id                Int             @id @default(autoincrement())
  orderId           String
  marketplaceUserId Int             // Buyer (MarketplaceUser id) who cancelled
  reason            String          // changed_mind, found_cheaper, wrong_item, delivery_issues, payment_issues, seller_issues, other
  reasonDetail      String?         // Optional text when reason is "other" or extra details
  cancelledAt       DateTime        @default(now()) @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  order             Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  marketplaceUser   MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([marketplaceUserId])
  @@index([marketplaceUserId, cancelledAt])
}

model Address {
  id                Int             @id @default(autoincrement())
  userId            Int
  fullName          String
  phone             String
  address           String
  addressNormalized String?
  latitude          Float?
  longitude         Float?
  geocodePrecision  String?
  isDefault         Boolean         @default(false)
  label             String
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  user              MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([userId, isDefault])
  @@index([addressNormalized])
}

model Order {
  id                      Int         @id @default(autoincrement())
  orderId                 String      @unique
  buyerId                 String?
  orderDate               DateTime    @db.Timestamptz(3)
  orderStatus             String
  paymentStatus           String
  deliveryMethod          String
  deliveryOption          String?
  subtotal                Decimal @db.Decimal(12, 2)
  discounts               Decimal @db.Decimal(12, 2)
  shippingFee             Decimal @db.Decimal(12, 2)
  totalAmount             Decimal @db.Decimal(12, 2)
  paymentTerms            String
  totalOrders             Int
  contactPerson           String
  storeName               String
  contactPhone            String
  customerEmail           String?
  deliveryAddress         String
  preferredDeliveryDate   DateTime?   @db.Timestamptz(3)
  preferredDeliveryTime   String?
  preferredPickupDate     DateTime?   @db.Timestamptz(3)
  preferredPickupTime     String?
  assignedLogistics       String?
  trackingNumber          String?
  deliveryNote            String?
  deliveryConfirmation    String?
  pod                     String?
  shippingMethodLabel     String?
  shippingMethod          String?
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(3)
  acceptedBy              String?
  acceptedAt              DateTime?   @db.Timestamptz(3)
  estimatedDeliveryDate   DateTime?   @db.Timestamptz(3)
  estimatedDeliveryMinDays Int?
  estimatedDeliveryMaxDays Int?
  deliveredAt             DateTime?   @db.Timestamptz(3)
  receivedAt              DateTime?   @db.Timestamptz(3) // When buyer marks order as received (marketplace)
  paidAt                  DateTime?   @db.Timestamptz(3) // When paymentStatus transitions to Paid
  /** First time distributor notified buyer of PO pricing; subsequent sends are pricing updates. */
  pricingSentAt           DateTime?   @db.Timestamptz(3)
  paymentProofUrls        String[]    @default([]) // Cloudinary or receipt URLs from buyer pay flow
  paymentProofFileNames   String[]    @default([]) // Original file names (parallel to paymentProofUrls)
  paymentProofSubmittedAt DateTime?   @db.Timestamptz(3)
  userId                  Int?
  archivedAt              DateTime?   @db.Timestamptz(3)
  cancelledAt             DateTime?   @db.Timestamptz(3)
  cancelledBy             String?
  cancellationReason      String?
  returnedAt              DateTime?   @db.Timestamptz(3)
  returnReason            String?     // reason code from return request
  returnReasonDetail      String?     // optional detail when reason is "other"
  returnStatus            String?     // Pending | Accepted | Rejected
  returnCollectedAt       DateTime?   @db.Timestamptz(3) // Driver collected return from buyer
  returnItemsReceivedAt   DateTime?   @db.Timestamptz(3) // Distributor confirmed return items received
  returnPod               String?     // Proof of return pickup (driver)
  isDeleted               Boolean     @default(false)
  buyerIdSnapshot         String?
  contactPersonSnapshot   String?
  contactPhoneSnapshot    String?
  customerEmailSnapshot   String?
  deliveryAddressSnapshot String?
  orderDateSnapshot       DateTime?   @db.Timestamptz(3)
  storeNameSnapshot       String?
  buyer                   Buyer?      @relation(fields: [buyerId], references: [buyerId])
  user                    User?       @relation(fields: [userId], references: [id])
  orderItemsRel           OrderItem[]
  productReviews          ProductReview[]
  orderDeliveryReview     OrderDeliveryReview?
  fleetId                 Int?
  fleet                   Fleet?       @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  returnRequests          OrderReturnRequest[]
  orderCancellations      OrderCancellation[]
  orderFailedReasons      OrderFailedReason[]
  matchCandidates         ClientMatchCandidate[]
  salesJobs               SalesJob[]

  // Indexes for performance - added to fix slow queries
  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([buyerId])
  @@index([createdAt])
  @@index([orderDate])
  @@index([paidAt])
  @@index([archivedAt])
  @@index([isDeleted])
  @@index([userId, orderStatus, isDeleted])
  @@index([userId, isDeleted, archivedAt])
  @@index([fleetId])
  // Composite indexes for common filter + sort patterns
  @@index([userId, isDeleted, createdAt])
  @@index([userId, isDeleted, orderDate])
  @@index([buyerId, createdAt])
  @@index([buyerId, orderDate])
  @@index([fleetId, createdAt])
  @@index([orderStatus, createdAt])
}

/// Structured record for driver-reported delivery failures (separate from buyer cancellations/returns).
model OrderFailedReason {
  id          Int       @id @default(autoincrement())
  orderId     String
  driverId    Int?
  reason      String    // Human-readable label selected by driver (e.g. "Customer unavailable")
  detail      String?   // Optional free-text detail (for "other" or extra context)
  imageUrls   String[]  @default([]) // Cloudinary evidence URLs from driver app (max 3 client-side)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  order       Order     @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([driverId])
  @@index([orderId, createdAt])
  @@index([driverId, createdAt])
}

/// Return/refund request from marketplace buyer (order must be Delivered or Received).
model OrderReturnRequest {
  id                Int             @id @default(autoincrement())
  orderId           String
  marketplaceUserId Int             // Buyer (MarketplaceUser id from JWT)
  reason            String          // e.g. wrong_item, defective, not_as_described, changed_mind, late_delivery, other
  reasonDetail      String?         // Optional text when reason is "other" or extra details
  imageUrls         String[]        @default([]) // Cloudinary evidence URLs, recommended max 5
  status            String          @default("Pending") // Pending | Approved | Rejected
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  order             Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  marketplaceUser   MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([marketplaceUserId])
  @@index([status])
  @@index([orderId, createdAt])
  @@index([marketplaceUserId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                       Int             @id @default(autoincrement())
  orderId                  String
  productId                String?
  variantId                Int? // Reference to ProductVariant
  variantOptionId          Int? // Reference to VariantOption (new combinations table)
  subtotal                 Decimal @db.Decimal(12, 2)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)
  productNameSnapshot      String?
  productSkuSnapshot       String?
  productTypeSnapshot      String?
  productImageSnapshot     String? // Primary image at time of order
  variantNameSnapshot      String? // Variant name at time of order
  variantAttributesSnapshot Json? // Structured attributes at time of order (e.g. {"Color":"Red","Size":"M"})
  test                     String?
  packageQuantity          Int?            @default(1)
  packageType              String?
  piecesPerPackage         Int?            @default(1)
  pricePerPackage          Decimal? @db.Decimal(12, 2)
  unitPriceSnapshot        Decimal? @db.Decimal(12, 2) // VariantOption sellingPrice at time of order
  currencySnapshot         String? // Seller currency at time of order (usually User.currency)
  // Offer snapshots - preserve offer status at time of purchase
  offerApplied             Boolean?        @default(false)
  offerBadgeSnapshot       String? // 'Discount', 'Promotion', 'All Offers', 'Offer'
  offerNameSnapshot        String? // Display name of the offer at time of purchase
  offerIdSnapshot          String? // Stable Offer.id at apply time (used by reverseOfferUsage)
  originalPriceSnapshot    Decimal? @db.Decimal(12, 2) // Original price before discount (for display)
  discountPercentage       Decimal? @db.Decimal(5, 2) // Calculated discount % at time of purchase (for percentage discounts)
  discountAmount           Decimal? @db.Decimal(12, 2) // Fixed discount amount at time of purchase (for fixed discounts)
  promotionDetailsSnapshot String? // JSON string of promotion details {minQuantity, freeQuantity, description}
  moqSnapshot              Int? // MOQ at time of order (in pieces) - for accurate promotion calculation in order history
  order                    Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product                  Product?        @relation(fields: [productId], references: [productId])
  variant                  ProductVariant? @relation(fields: [variantId], references: [id])
  variantOption            VariantOption?  @relation(fields: [variantOptionId], references: [id])

  // Indexes for performance - added to fix slow queries
  @@index([orderId])
  @@index([productId])
  @@index([orderId, productId])
  @@index([orderId, createdAt])
  @@index([productId, createdAt])
}

/// Combination rows for a product (each row corresponds to a concrete variant combination)
model VariantOption {
  id                   Int      @id @default(autoincrement())
  productId            Int
  variantName          String // e.g., "Color: Red | Size: M"
  attributes           Json // {"Color":"Red","Size":"M"}
  sku                  String?
  purchasePrice        Decimal @db.Decimal(12, 2)
  sellingPrice         Decimal @db.Decimal(12, 2)
  originalSellingPrice Decimal? @db.Decimal(12, 2) // legacy; unused — client rates do not rewrite catalog prices
  moq                  Int?
  stockQuantity        Int      @default(0)
  lowStockThreshold    Int      @default(0)
  stockStatus          String   @default("In Stock")
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  offers     Offer[]

  @@unique([productId, variantName])
  @@index([productId, isActive])
  @@index([productId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AppName {
  DASHBOARD
  MARKETPLACE
  DRIVER
}

enum AppActorType {
  DASHBOARD_USER
  MARKETPLACE_USER
  DRIVER
}

/// Session duration samples used for average time spent metrics across apps.
model AppSessionSample {
  id           String       @id @default(cuid())
  app          AppName
  actorType    AppActorType
  /// Points to the actor primary key (User.id / MarketplaceUser.id / Driver.id) depending on actorType.
  actorId      Int
  startedAt    DateTime     @db.Timestamptz(3)
  endedAt      DateTime     @db.Timestamptz(3)
  durationSec  Int
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([app, startedAt])
  @@index([actorType, actorId, startedAt])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// OTP codes for mobile authentication
model OtpCode {
  id          Int       @id @default(autoincrement())
  phone       String
  countryCode String?
  channel     String
  code        String
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  ipAddress   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

/// Generic user activity tracking for marketplace users
model UserActivity {
  id           Int             @id @default(autoincrement())
  userId       Int
  productId    String // Reference to marketplace product ID
  productData  Json // Store complete product data as JSON
  activityType String // 'cart', 'favorite', 'viewed', 'purchased'
  metadata     Json? // Additional data (quantity, variant, etc.)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  user         MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityType])
  @@index([productId])
  @@index([activityType])
}

/// Search history for marketplace users (synced across devices)
model SearchHistory {
  id        Int             @id @default(autoincrement())
  userId    Int
  query     String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  user      MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@unique([userId, query]) // Prevent duplicate queries per user
}

/// Raw marketplace search telemetry (used to find common typos and zero-result queries).
model MarketplaceSearchQueryLog {
  id          Int      @id @default(autoincrement())
  /// Optional marketplace user id (if available in the request).
  marketplaceUserId Int?
  query       String
  category    String?
  page        Int?
  limit       Int?
  resultCount Int
  /// Which engine answered the query ("meili" | "pg_trgm" | "js_score" | "prisma" | "cache").
  engine      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([query, createdAt])
  @@index([engine, createdAt])
}

enum MarketplaceSearchTermMapKind {
  SYNONYM
  TRANSLATION
}

model MarketplaceSearchTermMap {
  id           String   @id @default(cuid())
  kind         MarketplaceSearchTermMapKind
  fromTerm     String
  toTerm       String
  fromLocale   String?
  toLocale     String?
  bidirectional Boolean @default(true)
  enabled      Boolean  @default(true)

  createdByAdminId Int?
  createdByAdmin   PlatformAdmin? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([kind, enabled])
  @@index([fromTerm])
  @@index([toTerm])
  @@index([fromLocale, toLocale])
  @@unique([kind, fromTerm, toTerm, fromLocale, toLocale])
}

model Offer {
  id                 String    @id @default(cuid())
  offerId            String    @unique
  groupId            String? // shared id when one rate covers multiple products/variants
  userId             Int? // distributor
  buyerId            String? // Buyer.buyerId (client); null allowed for incomplete drafts
  productId          String? // Product.productId XOR categoryId (both null ok for drafts)
  categoryId         String? // merchandisingCategorySlug
  variantOptionId    Int? // null = whole product (all variants); set = that VariantOption only
  discountType       String // percentage | fixed_amount | buy_x_get_y
  discountValue      Decimal   @db.Decimal(10, 2)
  buyQuantity        Int? // required when buy_x_get_y; also set for combo with price discount
  freeQuantity       Int? // get-Y for buy_x_get_y / combo; null when price-only
  promotionApplyMode String    @default("after_moq") // from_zero = count free pieces before MOQ; after_moq = only above MOQ
  startDate          DateTime  @db.Timestamptz(3)
  endDate            DateTime? @db.Timestamptz(3) // null = standing/indefinite
  status             String    @default("draft") // draft | active | expired
  notes              String?
  description        String? // optional, keep column if already exists
  totalUsage         Int       @default(0)
  totalDiscountGiven Decimal   @default(0) @db.Decimal(12, 2)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  user          User?           @relation(fields: [userId], references: [id])
  buyer         Buyer?          @relation(fields: [buyerId], references: [buyerId], onDelete: SetNull)
  product       Product?        @relation(fields: [productId], references: [productId], onDelete: Cascade)
  variantOption VariantOption?  @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@index([buyerId])
  @@index([productId])
  @@index([categoryId])
  @@index([variantOptionId])
  @@index([status])
  @@index([userId, buyerId])
  @@index([userId, productId])
  @@index([userId, groupId])
  @@index([startDate, endDate])
}

// Kept in DB without Prisma relations (legacy usage tracking).
model OfferUsageTracking {
  id                String   @id @default(cuid())
  offerId           String
  discountTypeId    String? // Track per discount type, null for overall offer usage
  marketplaceUserId Int? // For marketplace users
  usageCount        Int      @default(1)
  lastUsedAt        DateTime @default(now()) @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@unique([offerId, discountTypeId, marketplaceUserId])
  @@index([offerId])
  @@index([discountTypeId])
  @@index([marketplaceUserId])
}

// Sales Module Models
model SalesAgent {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String
  role          String          // 'Sales Manager', 'Sales Rep', 'Sales Support', 'Lead Gen', 'Account Manager'
  status        String          // 'active', 'inactive'
  avatar        String?
  territory     String?
  bio           String?         // About me / biography
  sex           String?         // Gender (e.g., 'Male', 'Female', 'Other')
  teamId       String?
  userId       Int?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  team          SalesTeam?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fieldReports  FieldReport[]
  salesTargets  SalesTarget[]
  favoriteProducts FavoriteProduct[]
  salesJobs        SalesJob[]

  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model SalesTeam {
  id            String          @id @default(uuid())
  name          String          // Region name (e.g., "Jakarta Team", "Regional Team")
  userId       Int?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  members       SalesAgent[]

  @@index([userId])
}

model FieldReport {
  id            String          @id @default(uuid())
  salesAgentId  String
  date          DateTime        @db.Timestamptz(3)
  location      String?
  startTime     String?         // e.g., "08:00"
  endTime       String?          // e.g., "17:00"
  activities    Json?            // { visits, customersMet, productsDemonstrated, salesMade }
  notes         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  salesAgent    SalesAgent      @relation(fields: [salesAgentId], references: [id], onDelete: Cascade)

  @@index([salesAgentId])
  @@index([date])
}

model SalesTarget {
  id            String          @id @default(uuid())
  salesAgentId  String
  period        String          // e.g., "October", "Q4 2024"
  goal          Decimal         @db.Decimal(12, 2)
  achieved     Decimal         @default(0) @db.Decimal(12, 2)
  unitsSold     Int              @default(0)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  salesAgent    SalesAgent      @relation(fields: [salesAgentId], references: [id], onDelete: Cascade)

  @@index([salesAgentId])
  @@index([period])
}

model FavoriteProduct {
  id            String          @id @default(uuid())
  salesAgentId  String
  productId     Int
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  
  salesAgent    SalesAgent      @relation(fields: [salesAgentId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([salesAgentId, productId])
  @@index([salesAgentId])
  @@index([productId])
}

/// Notifications for dashboard users (distributors)
model Notification {
  id              String    @id @default(cuid())
  userId          Int
  type            String    // 'order' | 'inventory' | 'offer' | 'buyer' | 'sales' | 'product' | 'system'
  title           String
  message         String
  isRead          Boolean   @default(false)
  metadata        Json?     // Additional data like orderId, productId, etc.
  actionUrl       String?   // URL to navigate to when clicked
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  readAt          DateTime? @db.Timestamptz(3)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}

/// Push notification tokens for marketplace users (mobile app)
model PushNotificationToken {
  id              Int             @id @default(autoincrement())
  userId          Int
  token           String          @unique
  platform        String          // 'ios' | 'android' | 'web'
  isActive        Boolean         @default(true)
  /** BCP-47 / 2-letter code from the marketplace app (e.g. 'id', 'en'). Used to localize OS push when idle/closed. */
  language        String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  
  user            MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

/// Product review: one per (marketplaceUser, order, product). Buyer reviews a product from an order.
model ProductReview {
  id          Int      @id @default(autoincrement())
  userId      Int      // MarketplaceUser (buyer) who wrote the review
  orderId     String
  productId   String
  rating      Int      // 1-5
  title       String?
  comment     String?
  imageUrls   String[]  @default([]) // Cloudinary URLs, max 5
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user    MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([userId, orderId, productId])
  @@index([productId])
  @@index([orderId])
  @@index([userId])
  @@index([productId, createdAt])
  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

/// Delivery review: one per order. Buyer rates delivery for that order.
model OrderDeliveryReview {
  id              Int      @id @default(autoincrement())
  userId          Int      // MarketplaceUser (buyer)
  orderId         String   @unique
  deliveryRating  Int?     // 1-5
  deliveryComment String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  user  MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([userId, createdAt])
}

/// Distributor (seller) review: one per (buyer, distributor). Buyer reviews a seller.
model DistributorReview {
  id                    Int      @id @default(autoincrement())
  userId                Int      // MarketplaceUser (buyer)
  distributorId         Int      // User (seller/distributor)
  orderId               String?  // Optional: order that prompted the review
  overallRating         Int      // 1-5 required
  communicationRating   Int?     // 0-5
  deliveryRating        Int?     // 0-5
  productQualityRating  Int?     // 0-5
  wouldOrderAgain       String?  // 'yes' | 'no' | 'maybe'
  comment               String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  user        MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor User            @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([userId, distributorId])
  @@index([distributorId])
  @@index([userId])
  @@index([distributorId, createdAt])
  @@index([userId, createdAt])
}

/// Buyer-reported issues against a dashboard distributor (seller) — surfaced in platform admin.
model DistributorReport {
  id                        Int             @id @default(autoincrement())
  reportedDashboardUserId   Int
  reporterMarketplaceUserId Int
  reasonCode                String
  reasonText                String
  reasonDetail              String?
  imageUrls                 String[]        @default([]) // Cloudinary (or HTTPS) evidence URLs, max 5
  adminReadAt               DateTime?       @db.Timestamptz(3)
  /// When set, hidden from platform admin notification bell only; row kept for user-detail / audit.
  adminInboxDismissedAt     DateTime?       @db.Timestamptz(3)
  createdAt                 DateTime        @default(now()) @db.Timestamptz(3)

  reportedDashboardUser User            @relation("ReportedDistributorReports", fields: [reportedDashboardUserId], references: [id], onDelete: Cascade)
  reporter              MarketplaceUser @relation(fields: [reporterMarketplaceUserId], references: [id], onDelete: Cascade)

  @@index([reportedDashboardUserId])
  @@index([reporterMarketplaceUserId])
  @@index([createdAt])
  @@index([adminReadAt])
  @@index([adminInboxDismissedAt])
}

/// Distributor fleet / truck for logistics (route, vehicle, driver, assigned orders).
model Fleet {
  id                  Int       @id @default(autoincrement())
  fleetCode           String    // e.g. #AD345JK758 (display orderCode in UI)
  userId              Int
  route               String
  routeFrom           String?
  routeTo             String?
  status              String    // Available | Unavailable | In Transit | Checking
  deliveryType        String?
  etaCompletionDate   DateTime? @db.Timestamptz(3)
  etaCompletionTime   String?   // e.g. "12:00"
  assignedDate        DateTime? @db.Date       // date drivers see tasks for this fleet (Basic Fleet Info)
  lastUpdate          String
  vehicleType         String?
  vehicleBrand        String?
  vehicleModel        String?
  plateNumber         String?   // e.g. "B 1234 XYZ" – differentiate identical vehicles
  vehicleMaxWeight    Int?
  vehicleMaxVolume    Float?
  loadPct             Int?
  paymentTerms        String?
  totalOrders         Int?
  deliveriesCompleted Int?
  assignedLogistics   String?   // e.g. "Distributor Fleet" – label in Logistics details and on orders
  assignedOrderIds    Json?     // string[]
  completedOrderIds   Json?     // string[]
  customers           Json?     // { storeName: string; contactName: string }[]
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  driverId            Int?      // FK to Driver entity (null = legacy / ad-hoc driver entry)
  driver              Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders              Order[]

  @@index([userId])
  @@index([userId, status])
  @@index([driverId])
}

/// Canonical driver entity — one record per physical driver.
/// Credentials (username + passwordHash) live here, not on Fleet.
/// Fleet keeps denormalised snapshot fields (driverName etc.) for display.
model Driver {
  id            Int      @id @default(autoincrement())
  userId        Int      // distributor owner
  name          String
  phone         String?
  experience    String?
  status        String?
  avatar        String?
  username      String   @unique   // Laku Driver app login
  passwordHash  String             // bcrypt hash; never returned to client
  lastLat       Float?             // last known GPS latitude (synced from Laku-Driver app)
  lastLng       Float?             // last known GPS longitude
  lastLocationAt DateTime? @db.Timestamptz(3) // when the location was last updated
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleets        Fleet[]
  failedReasons OrderFailedReason[]
  pushTokens    DriverPushNotificationToken[]

  @@index([userId])
}

/// Expo push notification tokens for Laku-Driver app users.
model DriverPushNotificationToken {
  id        Int      @id @default(autoincrement())
  driverId  Int
  token     String   @unique
  platform  String   // 'ios' | 'android'
  isActive  Boolean  @default(true)
  /** BCP-47 / 2-letter code reported by the driver app (e.g. 'id', 'en').
   * Used by the server to localize OS push banners delivered while the app is idle/closed. */
  language  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([token])
  @@index([isActive])
}

/// A pending request from a driver to join a distributor's fleet.
/// Created by the Laku-Driver app; resolved (approved/rejected) by the distributor on the dashboard.
model DriverRequest {
  id               String   @id @default(cuid())
  name             String
  phone            String
  distributorEmail String
  message          String?
  /// "pending" | "approved" | "rejected"
  status           String   @default("pending")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@index([distributorEmail])
  @@index([status])
}

/// Platform administrators (Laku internal) — separate from distributor `User`.
/// Used for managing marketplace-wide updates, banners, suspensions, etc.
model PlatformAdmin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  announcements PlatformAnnouncement[]
  homeOffers    MarketplaceHomeOffer[]
  searchTermMaps MarketplaceSearchTermMap[]
  commissionInvoices CommissionInvoice[]
  registrationInboxStates PlatformAdminInboxState[]
}

/// Per-admin read/dismiss state for synthesized registration inbox items.
model PlatformAdminInboxState {
  id          Int       @id @default(autoincrement())
  adminId     Int
  source      String    // 'dashboard' | 'marketplace'
  userId      Int
  readAt      DateTime? @db.Timestamptz(3)
  dismissedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  admin       PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, source, userId])
  @@index([adminId])
}

/// Marketplace-wide announcements shown in mobile "Latest updates".
model PlatformAnnouncement {
  id            Int      @id @default(autoincrement())
  title         String
  body          String
  category      String   @default("update") // 'update' | 'promotion' | 'maintenance' etc.
  imageUrl      String?
  linkUrl       String?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  createdByAdminId Int?
  createdByAdmin   PlatformAdmin? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([category])
}

/// Homepage “Special Offers” sale banner (platform admin → Marketplace home).
model MarketplaceHomeOffer {
  id              Int       @id @default(autoincrement())
  title           String
  subtitle        String    @default("")
  discountText    String    @default("")
  endDateText     String    @default("")
  backgroundColor String    @default("#0a61d7")
  textColor       String    @default("#FFFFFF")
  /// Plain text / light markdown shown on the offer detail screen
  detailsBody     String    @default("")
  /// Optional hero image behind text (HTTPS URL). Tints with backgroundColor for readability.
  bannerImageUrl  String?
  /// Full-width designed banner (Canva/Photoshop). When set, home shows this image only; copy fields still power the detail screen.
  customBannerImageUrl String?
  /// Ionicons name for the large right-side icon (e.g. gift, flame, pricetag).
  rightIconKey    String    @default("gift")
  /// Ionicons name inside the discount pill (e.g. flash, pricetag, star).
  discountIconKey String    @default("flash")
  isPublished     Boolean   @default(false)
  publishedAt     DateTime? @db.Timestamptz(3)
  /// Lower numbers sort first when multiple rows are published
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  createdByAdminId Int?
  createdByAdmin   PlatformAdmin? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder, publishedAt])
}

/// Distributor automation workflow (trigger → Laku Agent → action). Execution engine is Phase 2.
model AutomationWorkflow {
  id            String   @id @default(cuid())
  userId        Int
  name          String
  description   String   @default("")
  /// 'product_offers' | 'lead_management' | 'order_logistics' | 'marketing'
  type          String
  /// 'active' | 'paused' | 'draft'
  status        String   @default("draft")
  triggerType   String
  triggerConfig Json     @default("{}")
  /// Optional Laku Agent middle-step config
  agentConfig   Json?
  actionType    String
  actionConfig  Json     @default("{}")
  /// Business WhatsApp number used by this workflow to message buyers (E.164 recommended).
  whatsappPhone String?
  /// Business Gmail address used by this workflow to email buyers.
  gmailEmail    String?
  runs          Int      @default(0)
  lastRunAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runsLog AutomationRun[]

  @@index([userId, status])
  @@index([userId, type])
  @@index([createdAt])
}

model AutomationRun {
  id         String   @id @default(cuid())
  workflowId String
  /// 'success' | 'failed' | 'skipped' | 'in_progress'
  status     String
  message    String?
  /// Idempotency key for scheduled/event claims. Null for manual test runs.
  runKey     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, runKey])
  @@index([workflowId, createdAt])
}

/// Field task for a sales rep. AI suggestions stay "suggested" until a manager approves them.
model SalesJob {
  id                String    @id @default(uuid())
  distributorId     Int
  assignedTo        String
  clientId          String
  /// First selected order. Points at Order.orderId.
  orderId           String?
  /// Every order linked to a take_order or collect_payment job.
  orderIds          String[]  @default([])
  /// take_order | collect_payment | promote_product | stock_check | prospect_new_outlet
  jobType           String
  priorityReason    String?
  suggestedProducts String[]  @default([])
  /// ai | manager
  createdBy         String
  /// suggested | approved | dispatched | in_progress | completed | skipped
  status            String
  scheduledDate     DateTime  @db.Timestamptz(3)
  completionNotes   String?
  /// order_placed, order_amount, payment_collected, payment_amount, stock_checked, products_demoed, notes
  completionData    Json?
  whatsappMessageId String?
  dispatchNote      String?
  dispatchedAt      DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  distributor User              @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  agent       SalesAgent        @relation(fields: [assignedTo], references: [id], onDelete: Restrict)
  client      Buyer             @relation(fields: [clientId], references: [buyerId], onDelete: Restrict)
  order       Order?            @relation(fields: [orderId], references: [orderId], onDelete: SetNull)
  schedules   SalesJobSchedule[]

  @@index([distributorId, status])
  @@index([assignedTo, scheduledDate])
  @@index([clientId])
  @@index([distributorId, scheduledDate])
  @@index([orderId])
}

/// One visit date and the WhatsApp reminder clock time for that date.
model SalesJobSchedule {
  id             String    @id @default(uuid())
  jobId          String
  scheduledDate  DateTime  @db.Timestamptz(3)
  reminderHour   Int
  reminderMinute Int
  sentAt         DateTime? @db.Timestamptz(3)

  job SalesJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([scheduledDate, reminderHour, reminderMinute])
}

/// When the morning WhatsApp job list goes out, and when unanswered jobs are flagged.
model SalesJobSettings {
  distributorId        Int     @id
  dispatchHour         Int     @default(7)
  dispatchMinute       Int     @default(0)
  unresolvedCutoffHour Int     @default(18)
  timezone             String  @default("Asia/Jakarta")
  lastSuggestedDateKey String?
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  distributor User @relation(fields: [distributorId], references: [id], onDelete: Cascade)
}

/// Possible duplicate between a rep-created client and a marketplace buyer.
model ClientMatchCandidate {
  id                   String    @id @default(uuid())
  distributorId        Int
  existingClientId     String
  incomingOrderId      String
  provisionalClientId  String?
  confidenceScore      Int
  matchedSignals       String[]  @default([])
  /// pending | merged | not_a_match | needs_more_info
  status               String
  autoMerged           Boolean   @default(false)
  /// Prior client status and the marketplace buyer profile, used by Undo.
  undoSnapshot         Json?
  undoneAt             DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  distributor    User  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  existingClient Buyer @relation("MatchExistingClient", fields: [existingClientId], references: [buyerId], onDelete: Cascade)
  incomingOrder  Order @relation(fields: [incomingOrderId], references: [orderId], onDelete: Cascade)

  @@index([distributorId, status])
  @@index([distributorId, autoMerged, createdAt])
  @@index([incomingOrderId])
  @@index([existingClientId])
}

