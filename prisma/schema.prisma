generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  // For OAuth users these may be null; for email/password users we can enforce app-level validation
  firstName      String?
  lastName       String?
  // NextAuth expected fields
  name           String?
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  // Password is optional to allow Google OAuth users
  password       String?

  company        String?
  address        String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  currency       String     @default("IDR")
  region         String?
  buyers         Buyer[]
  orders         Order[]
  products       Product[]
  suppliers      Supplier[]
  accounts       Account[]
  sessions       Session[]
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Product {
  id                Int         @id @default(autoincrement())
  productId         String      @unique
  sku               String
  name              String
  description       String
  category          String
  brand             String
  supplier          String
  stockQuantity     Int
  lowStockThreshold Int?
  stockStatus       String?
  purchasePrice     String
  sellingPrice      String
  status            String
  catalogType       String
  catalogName       String
  images            String[]
  discount          Float?
  discountType      String?
  // Product assurance fields
  halalCertified    Boolean?    @default(false)
  bpomApproved      Boolean?    @default(false)
  originalProduct   Boolean?    @default(true)
  returnPolicyDays  Int?        @default(7)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  userId            Int?
  orderItems        OrderItem[]
  user              User?       @relation(fields: [userId], references: [id])
}

model Order {
  id                    Int         @id @default(autoincrement())
  orderId               String      @unique
  buyerId               String?
  // Snapshots to preserve buyer-related display data if buyer is deleted (FK set null)
  buyerIdSnapshot       String?
  orderDate             DateTime   @db.Timestamptz(3)
  orderDateSnapshot     DateTime?  @db.Timestamptz(3)
  orderStatus           String
  paymentStatus         String
  deliveryMethod        String
  subtotal              Float
  discounts             Float
  taxes                 Float
  shippingFee           Float
  totalAmount           Float
  paymentTerms          String
  totalOrders           Int
  contactPerson         String
  contactPersonSnapshot String?
  storeName             String
  storeNameSnapshot     String?
  contactPhone          String
  contactPhoneSnapshot  String?
  customerEmail         String?
  customerEmailSnapshot String?
  deliveryAddress       String
  deliveryAddressSnapshot String?
  preferredDeliveryTime String?
  assignedLogistics     String?
  trackingNumber        String?
  deliveryNote          String?
  deliveryConfirmation  String?
  pod                   String?
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)
  acceptedBy            String?
  acceptedAt            DateTime?  @db.Timestamptz(3)
  archivedAt            DateTime?  @db.Timestamptz(3)
  userId                Int?
  buyer                 Buyer?      @relation(fields: [buyerId], references: [buyerId], onDelete: SetNull)
  user                  User?       @relation(fields: [userId], references: [id])
  orderItemsRel         OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId String?
  quantity  Int
  unitPrice Float
  subtotal  Float
  // Snapshots to preserve display data if product is deleted
  productNameSnapshot String?
  productSkuSnapshot  String?
  productCategorySnapshot String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [productId], onDelete: SetNull)

  // If uniqueness is required, consider adding a lineIndex instead. Dropping composite unique to allow null productId.
}

// NextAuth models (required for Prisma Adapter)
model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @map("refresh_token")
  access_token       String?  @map("access_token")
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
