generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  firstName     String?
  lastName      String?
  email         String     @unique
  password      String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  currency      String     @default("IDR")
  region        String?
  emailVerified DateTime?
  image         String?
  name          String?
  avatar        String?
  bio           String?
  location      String?
  phone         String?
  companyId     Int?
  language      String     @default("en")
  accounts      Account[]
  buyers        Buyer[]
  orders        Order[]
  products      Product[]
  sessions      Session[]
  suppliers     Supplier[]
  company       Company?   @relation(fields: [companyId], references: [id])
}

model Company {
  id                          Int      @id @default(autoincrement())
  name                        String
  businessRegistrationNumber  String?
  taxId                       String?
  logo                        String?
  industryType                String?
  businessDescription         String?
  yearsInOperation            String?
  companySize                 String?
  businessAddress             String?
  businessPhone               String?
  businessEmail               String?
  documentVerification        Boolean  @default(false)
  businessLicenseVerification Boolean  @default(false)
  complianceStatus            String   @default("Pending")
  shippingPreferences         String?
  deliveryTimeSlots           String?
  preferredDeliveryDays       String?
  specialInstructions         String?
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)
  bannerImage                 String?
  additionalPricePerKm        Float?
  baseShippingPrice           Float?
  baseShippingRadius          Float?
  freeShippingThreshold       Float?
  maxShippingRadius           Float?
  // Additional shipping options pricing
  expressShippingPrice        Float?
  nextDayShippingPrice        Float?
  sameDayShippingPrice        Float?

  users                       User[]
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Product {
  id                Int         @id @default(autoincrement())
  productId         String      @unique
  sku               String
  name              String
  description       String
  category          String
  brand             String
  supplier          String
  stockQuantity     Int
  lowStockThreshold Int?
  stockStatus       String?
  purchasePrice     String
  sellingPrice      String
  status            String
  catalogType       String
  catalogName       String
  images            String[]
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  userId            Int?
  bpomApproved      Boolean?    @default(false)
  halalCertified    Boolean?    @default(false)
  originalProduct   Boolean?    @default(true)
  returnPolicyDays  Int?        @default(7)
  packageType       String?
  piecesPerPackage  Int?        @default(1)
  lastSyncAt        DateTime?
  marketplaceStatus String?     @default("Not Published")
  publishedAt       DateTime?
  orderItems        OrderItem[]
  user              User?       @relation(fields: [userId], references: [id])
}

model MarketplaceUser {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String?   @unique
  password      String?
  bio           String?
  phone         String    @unique
  country       String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  name          String?
  storeName     String?
  chosenAddress String?
  image         String?
  bannerImage   String?
  addresses     Address[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

model Address {
  id        Int             @id @default(autoincrement())
  userId    Int
  fullName  String
  phone     String
  address   String
  isDefault Boolean         @default(false)
  label     String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  user      MarketplaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([userId, isDefault])
}

model Order {
  id                      Int         @id @default(autoincrement())
  orderId                 String      @unique
  buyerId                 String?
  orderDate               DateTime    @db.Timestamptz(3)
  orderStatus             String
  paymentStatus           String
  deliveryMethod          String
  subtotal                Float
  discounts               Float
  shippingFee             Float
  totalAmount             Float
  paymentTerms            String
  totalOrders             Int
  contactPerson           String
  storeName               String
  contactPhone            String
  customerEmail           String?
  deliveryAddress         String
  preferredDeliveryTime   String?
  assignedLogistics       String?
  trackingNumber          String?
  deliveryNote            String?
  deliveryConfirmation    String?
  pod                     String?
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(3)
  acceptedBy              String?
  acceptedAt              DateTime?   @db.Timestamptz(3)
  userId                  Int?
  archivedAt              DateTime?   @db.Timestamptz(3)
  buyerIdSnapshot         String?
  contactPersonSnapshot   String?
  contactPhoneSnapshot    String?
  customerEmailSnapshot   String?
  deliveryAddressSnapshot String?
  orderDateSnapshot       DateTime?   @db.Timestamptz(3)
  storeNameSnapshot       String?
  buyer                   Buyer?      @relation(fields: [buyerId], references: [buyerId])
  user                    User?       @relation(fields: [userId], references: [id])
  orderItemsRel           OrderItem[]
}

model OrderItem {
  id                      Int      @id @default(autoincrement())
  orderId                 String
  productId               String?
  subtotal                Float
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  productNameSnapshot     String?
  productSkuSnapshot      String?
  productCategorySnapshot String?
  packageQuantity         Int?     @default(1)
  packageType             String?
  piecesPerPackage        Int?     @default(1)
  pricePerPackage         Float?
  order                   Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product                 Product? @relation(fields: [productId], references: [productId])
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// OTP codes for mobile authentication
model OtpCode {
  id          Int       @id @default(autoincrement())
  phone       String
  countryCode String?
  channel     String
  code        String
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  ipAddress   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}
