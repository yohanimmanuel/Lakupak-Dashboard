generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String
  lastName  String
  email     String     @unique
  password  String
  company   String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  currency  String     @default("IDR")
  region    String?
  buyers    Buyer[]
  orders    Order[]
  products  Product[]
  suppliers Supplier[]
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Product {
  id                Int         @id @default(autoincrement())
  productId         String      @unique
  sku               String
  name              String
  description       String
  category          String
  brand             String
  supplier          String
  stockQuantity     Int
  lowStockThreshold Int?
  stockStatus       String?
  purchasePrice     String
  sellingPrice      String
  status            String
  catalogType       String
  catalogName       String
  images            String[]
  discount          Float?
  discountType      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  userId            Int?
  orderItems        OrderItem[]
  user              User?       @relation(fields: [userId], references: [id])
}

model Order {
  id                    Int         @id @default(autoincrement())
  orderId               String      @unique
  buyerId               String
  orderDate             DateTime
  orderStatus           String
  paymentStatus         String
  deliveryMethod        String
  subtotal              Float
  discounts             Float
  taxes                 Float
  shippingFee           Float
  totalAmount           Float
  paymentTerms          String
  totalOrders           Int
  contactPerson         String
  storeName             String
  contactPhone          String
  customerEmail         String?
  deliveryAddress       String
  preferredDeliveryTime String?
  assignedLogistics     String?
  trackingNumber        String?
  deliveryNote          String?
  deliveryConfirmation  String?
  pod                   String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  acceptedBy            String?
  acceptedAt            DateTime?
  userId                Int?
  buyer                 Buyer       @relation(fields: [buyerId], references: [buyerId])
  user                  User?       @relation(fields: [userId], references: [id])
  orderItemsRel         OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [productId])

  @@unique([orderId, productId])
}
