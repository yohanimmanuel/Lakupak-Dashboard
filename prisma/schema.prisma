generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String
  lastName  String
  email     String     @unique
  password  String
  company   String?
  address   String?
  region    String?
  currency  String     @default("IDR")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buyers    Buyer[]
  suppliers Supplier[]
  products  Product[]
  orders    Order[]    // Add relation to orders
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]  // Add relation to orders
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model Product {
  id                 Int      @id @default(autoincrement())
  productId          String   @unique
  sku                String
  name               String
  description        String
  category           String
  brand              String
  supplier           String
  stockQuantity      Int
  lowStockThreshold  Int?
  stockStatus        String?
  purchasePrice      String
  sellingPrice       String
  status             String
  catalogType        String
  catalogName        String
  images             String[]
  discount           Float?
  discountType       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             Int?
  user               User?    @relation(fields: [userId], references: [id])
}

model Order {
  id                    Int      @id @default(autoincrement())
  orderId               String   @unique
  buyerId               String
  orderDate             DateTime
  orderStatus           String
  paymentStatus         String
  deliveryMethod        String
  
  // Financial data
  subtotal              Float
  discounts             Float
  taxes                 Float
  shippingFee           Float
  totalAmount           Float
  paymentTerms          String
  
  // Order quantity
  totalOrders           Int
  
  // Customer information
  contactPerson         String
  storeName             String
  contactPhone          String
  customerEmail         String?
  
  // Delivery service
  deliveryAddress       String
  preferredDeliveryTime String?
  assignedLogistics     String?
  trackingNumber        String?
  deliveryNote          String?
  deliveryConfirmation  String?
  pod                   String?
  
  // Order items as JSON string
  orderItems            String
  
  // Audit & logs
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  acceptedBy            String?
  acceptedAt            DateTime?
  
  // Relationships
  buyer                 Buyer?   @relation(fields: [buyerId], references: [buyerId])
  userId                Int?
  user                  User?    @relation(fields: [userId], references: [id])
}
