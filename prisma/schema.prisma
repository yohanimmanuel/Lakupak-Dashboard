// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  company   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  buyers   Buyer[]
  suppliers Supplier[]
}

model Buyer {
  id           Int      @id @default(autoincrement())
  buyerId      String   @unique
  avatar       String?
  owner        String
  email        String
  phone        String
  storeName    String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  orderDetails String?
  updatedAt    DateTime @updatedAt
  
  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierId   String   @unique
  name         String
  contact      String
  email        String
  phone        String
  businessType String
  address      String
  status       String
  createdAt    DateTime @default(now())
  logistics    String?
  notes        String?
  supplies     String?
  updatedAt    DateTime @updatedAt
  
  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}
