# Copy this to .env.docker and fill in secrets.
# docker-compose.yml already sets DATABASE_URL, DIRECT_URL, REDIS_URL, NEXTAUTH_URL, NEXT_PUBLIC_APP_URL.
# Add any other variables from env.example you need (e.g. AUTH_SECRET, JWT_SECRET, Cloudinary, Twilio).

AUTH_SECRET=your-secret-key-here
JWT_SECRET=replace-with-long-random-secret

# Optional: copy other vars from env.example (SMTP, Twilio, Cloudinary, etc.)
