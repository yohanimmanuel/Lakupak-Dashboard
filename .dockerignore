# Dependencies (build runs inside Docker; builder creates its own .next)
node_modules
.next
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Git and IDE
.git
.gitignore
.idea
# Exclude markdown except public documentation (loaded at build + runtime)
*.md
!content/docs/**
.vscode
.cursor

# Environment (use env_file or compose env instead)
.env
.env.*
!.env.example
!env.example

# Build/cache (not needed in image)
.turbo
dist
.cache
*.tsbuildinfo
.eslintcache

# Tests and coverage (not needed at runtime)
coverage
**/__tests__
**/*.test.*
**/*.spec.*
**/__snapshots__

# Local dev DB and dumps
prisma/*.db
*.dump
baseline.sql

# Misc
Dockerfile*
docker-compose*
.dockerignore
Thumbs.db
